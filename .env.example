# Gran Polla Mundial 2026 — Variables de entorno
# Copiar este archivo como .env.local y rellenar los valores reales.
# NUNCA commitear .env.local

# ── Supabase (obligatorio) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://XXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin ─────────────────────────────────────────────────────
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── URL pública de la app (para recalc server-to-server) ──────
NEXT_PUBLIC_APP_URL=https://tu-dominio.vercel.app

# ── TheSportsDB (fuente de partidos del Mundial) ──────────────
# Plan Single Developer — https://www.thesportsdb.com/api.php
THESPORTSDB_API_KEY=
WORLDCUP_LEAGUE_ID=4429

# ── Modo del provider de resultados en vivo ───────────────────
# thesportsdb = pull automático (default)
# manual      = admin actualiza a mano desde /admin/results
LIVE_PROVIDER=thesportsdb

# ── Cron jobs (Vercel) ────────────────────────────────────────
# Generar con: openssl rand -hex 32
CRON_SECRET=

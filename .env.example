# Gran Polla Mundial 2026 — Variables de entorno
# Copiar este archivo como .env.local y rellenar los valores reales.
# NUNCA commitear .env.local

# ── Supabase (obligatorio) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://XXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin ─────────────────────────────────────────────────────
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── URL pública de la app (para recalc server-to-server desde webhook) ──
NEXT_PUBLIC_APP_URL=https://tu-dominio.vercel.app

# ── BallDontLie Webhooks (resultados en vivo) ─────────────────
# Obtener en: https://app.balldontlie.io → Webhooks → Create endpoint
BALLDONTLIE_API_KEY=
BALLDONTLIE_WEBHOOK_SECRET=

# ── Modo del provider de resultados en vivo ───────────────────
# webhook = BallDontLie push (default)
# manual  = admin actualiza a mano
# poll    = reconciliador pull (no implementado)
LIVE_PROVIDER=webhook

# ── Opcionales ────────────────────────────────────────────────
RECONCILE_LIVE=false
LOG_WEBHOOK_PAYLOAD=false
# FOOTBALL_API_KEY=
